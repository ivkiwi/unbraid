@@ -0,0 +1,136 @@
+package embed
+
+import (
+	"net/netip"
+	"sort"
+
+	"github.com/netbirdio/netbird/client/internal/peer"
+	"github.com/netbirdio/netbird/client/internal/routemanager"
+	"github.com/netbirdio/netbird/route"
+)
+
+// ExitNode is an exit-node network (a default route) that management offers this peer.
+type ExitNode struct {
+	// ID is its network ID (what Options.PinnedExitNode takes).
+	ID string
+	// Peers are the WireGuard public keys of the routing peers that serve it.
+	Peers []string
+	// Selected reports whether its default route is the one installed for this peer.
+	Selected bool
+}
+
+// routes returns the route manager once the engine has set it up fully ([internal.Engine.ReadyRouteManager]).
+func (c *Client) routes() (routemanager.Manager, error) {
+	engine, err := c.getEngine()
+	if err != nil {
+		return nil, err
+	}
+	rm := engine.ReadyRouteManager()
+	if rm == nil {
+		return nil, ErrEngineNotStarted
+	}
+	return rm, nil
+}
+
+// ExitNodes lists the exit nodes this peer may use, sorted by ID. Selected is what gets installed (so, with an exit
+// node pinned, only that one); routes are read by network, as a network ID may also carry ordinary networks.
+func (c *Client) ExitNodes() ([]ExitNode, error) {
+	rm, err := c.routes()
+	if err != nil {
+		return nil, err
+	}
+	defaults := make(map[route.NetID][]*route.Route)
+	for id, routes := range rm.GetClientRoutes() {
+		if isExit(routes) {
+			defaults[id.NetID()] = append(defaults[id.NetID()], routes...)
+		}
+	}
+	selected := make(map[route.NetID]bool)
+	for id, routes := range rm.GetSelectedClientRoutes() {
+		if isExit(routes) {
+			selected[id.NetID()] = true
+		}
+	}
+	// The IPv6 half of an exit node follows its IPv4 base: list such a pair once.
+	paired := route.V6ExitMergeSet(defaults)
+	var nodes []ExitNode
+	for id, routes := range defaults {
+		if _, ok := paired[id]; ok {
+			continue
+		}
+		n := ExitNode{ID: string(id), Selected: selected[id]}
+		for _, r := range routes {
+			n.Peers = append(n.Peers, r.Peer)
+		}
+		nodes = append(nodes, n)
+	}
+	sort.Slice(nodes, func(i, j int) bool { return nodes[i].ID < nodes[j].ID })
+	return nodes, nil
+}
+
+// RoutedPrefixes lists the networks behind routing peers that this peer currently reaches (selected network routes
+// with an IP range; exit nodes and domain routes are left out), sorted and without repeats.
+func (c *Client) RoutedPrefixes() ([]netip.Prefix, error) {
+	rm, err := c.routes()
+	if err != nil {
+		return nil, err
+	}
+	selector := rm.GetRouteSelector()
+	seen := map[netip.Prefix]struct{}{}
+	// By network and ID: one network ID may name several networks.
+	for haID, routes := range rm.GetClientRoutes() {
+		if len(routes) == 0 || isExit(routes) || !selector.IsSelected(haID.NetID()) || routes[0].IsDynamic() || !routes[0].Network.IsValid() {
+			continue
+		}
+		seen[routes[0].Network.Masked()] = struct{}{}
+	}
+	prefixes := make([]netip.Prefix, 0, len(seen))
+	for p := range seen {
+		prefixes = append(prefixes, p)
+	}
+	sort.Slice(prefixes, func(i, j int) bool { return prefixes[i].String() < prefixes[j].String() })
+	return prefixes, nil
+}
+
+// NetworkChanged tells the client that the host switched networks: its management, signal and relay connections
+// redial on the new one.
+func (c *Client) NetworkChanged() {
+	c.netEvents.NotifyNetworkChange()
+}
+
+// MapToken names the running engine and the network map it has applied in full, else nil (no map yet, or one being
+// applied). Equal tokens before and after reading the client's state mean that state came from one engine and one map.
+func (c *Client) MapToken() any {
+	engine, err := c.getEngine()
+	if err != nil {
+		return nil
+	}
+	n := engine.MapCount()
+	if !engine.MapApplied() || engine.MapCount() != n {
+		return nil
+	}
+	return mapToken{engine, n}
+}
+
+type mapToken struct {
+	engine any
+	count  uint64
+}
+
+// Snapshot is the client's last known state without running health probes (no network calls), unlike Status.
+func (c *Client) Snapshot() peer.FullStatus {
+	return c.recorder.GetFullStatus()
+}
+
+// Exited reports whether a started client's run loop has ended for good: stopped, or a permanent error such as a
+// login its management server no longer accepts. Its status still reads as it last was.
+func (c *Client) Exited() bool {
+	c.mu.Lock()
+	connect := c.connect
+	c.mu.Unlock()
+	return connect != nil && connect.Exited()
+}
+
+func isExit(routes []*route.Route) bool {
+	return len(routes) > 0 && (route.IsV4DefaultRoute(routes[0].Network) || route.IsV6DefaultRoute(routes[0].Network))
+}
