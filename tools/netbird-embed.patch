+// selected is what the route selector lets through. With an exit node pinned, no default route but the pinned
+// node's gets through either: one under its own network ID, or the IPv6 one of its "-v6" half while its IPv4 base is
+// on this map. Dropped by network and ID, so a routing peer's subnet stays though its default route goes.
+func (m *DefaultManager) selected(routes route.HAMap) route.HAMap {
+	out := m.routeSelector.FilterSelectedExitNodes(routes) // a new map: entries can go
+	if m.pinnedExit == "" {
+		return out
+	}
+	pinnedV6 := route.NetID(string(m.pinnedExit) + route.V6ExitSuffix)
+	base := false
+	for id, routes := range routes {
+		base = base || id.NetID() == m.pinnedExit && len(routes) > 0 && route.IsV4DefaultRoute(routes[0].Network)
+	}
+	for id, routes := range out {
+		if !isExitNodeRoutes(routes) {
+			continue
+		}
+		if n := id.NetID(); n == m.pinnedExit || base && n == pinnedV6 && route.IsV6DefaultRoute(routes[0].Network) {
+			continue
+		}
+		delete(out, id)
+	}
+	return out
+}
+
+// enforcePinnedExit selects the pinned exit node, with its IPv6 half when it has one, whenever management offers it.
+// Nothing else is deselected: that would stay recorded for the whole network ID, and cut off an ordinary network the
+// same routing peer offers later. Other exit nodes' default routes are dropped where routes are installed (selected).
+func (m *DefaultManager) enforcePinnedExit(clientRoutes route.HAMap) {
+	defaults := make(map[route.NetID][]*route.Route)
+	for haID, routes := range clientRoutes {
+		if isExitNodeRoutes(routes) {
+			defaults[haID.NetID()] = append(defaults[haID.NetID()], routes...)
+		}
+	}
+	if _, offered := defaults[m.pinnedExit]; !offered {
+		return
+	}
+	m.routeSelector.SetExclusiveExitNode(m.pinnedExit, nil)
+	pinnedV6 := route.NetID(string(m.pinnedExit) + route.V6ExitSuffix)
+	if _, paired := route.V6ExitMergeSet(defaults)[pinnedV6]; paired {
+		m.routeSelector.SetExclusiveExitNode(pinnedV6, nil)
+	}
+}
