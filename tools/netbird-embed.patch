diff --git a/client/internal/routemanager/pinned_exit_test.go b/client/internal/routemanager/pinned_exit_test.go
new file mode 100644
index 0000000..3f17dcd
--- /dev/null
+++ b/client/internal/routemanager/pinned_exit_test.go
@@ -0,0 +1,115 @@
+package routemanager
+
+import (
+	"net/netip"
+	"sort"
+	"testing"
+
+	"github.com/netbirdio/netbird/client/internal/routeselector"
+	"github.com/netbirdio/netbird/route"
+)
+
+func TestPinnedExitNode(t *testing.T) {
+	exit := func(id, network string, auto bool) *route.Route {
+		return &route.Route{ID: route.ID(id), NetID: route.NetID(id), Network: netip.MustParsePrefix(network), Peer: id, SkipAutoApply: !auto}
+	}
+	routes := func(rs ...*route.Route) route.HAMap {
+		m := route.HAMap{}
+		for _, r := range rs {
+			m[r.GetHAUniqueID()] = append(m[r.GetHAUniqueID()], r)
+		}
+		return m
+	}
+	// What would be installed: the exit routes the selector lets through.
+	installed := func(m *DefaultManager, rs route.HAMap) []string {
+		var ids []string
+		for id := range m.selected(rs) {
+			ids = append(ids, string(id.NetID()))
+		}
+		sort.Strings(ids)
+		return ids
+	}
+	same := func(a, b []string) bool {
+		if len(a) != len(b) {
+			return false
+		}
+		for i := range a {
+			if a[i] != b[i] {
+				return false
+			}
+		}
+		return true
+	}
+	// On the first map: A and its IPv6 half only, though management auto-applies B (paired) and a standalone IPv4
+	// exit node whose name ends in "-v6".
+	first := routes(exit("A", "0.0.0.0/0", false), exit("A-v6", "::/0", false), exit("B", "0.0.0.0/0", true), exit("B-v6", "::/0", true),
+		exit("office-v6", "0.0.0.0/0", true))
+	m := &DefaultManager{routeSelector: routeselector.NewRouteSelector(), pinnedExit: "A"}
+	m.updateRouteSelectorFromManagement(first)
+	if got := installed(m, first); !same(got, []string{"A", "A-v6"}) {
+		t.Fatalf("pinned A: installed %v", got)
+	}
+	// A gone from the map: no default route at all.
+	gone := routes(exit("B", "0.0.0.0/0", true), exit("B-v6", "::/0", true))
+	m.updateRouteSelectorFromManagement(gone)
+	if got := installed(m, gone); len(got) != 0 {
+		t.Fatalf("pinned A missing: installed %v", got)
+	}
+	// Pinned to one never offered, from the start: none.
+	missing := &DefaultManager{routeSelector: routeselector.NewRouteSelector(), pinnedExit: "C"}
+	missing.updateRouteSelectorFromManagement(first)
+	if got := installed(missing, first); len(got) != 0 {
+		t.Fatalf("pinned C: installed %v", got)
+	}
+	// A routing peer whose network ID carries a subnet and an auto-applied default route: its subnet stays, its
+	// default route goes, whatever order the map is read in. What gets installed, by network and ID.
+	subnet := &route.Route{ID: "B-lan", NetID: "B", Network: netip.MustParsePrefix("10.1.0.0/24"), Peer: "B"}
+	mixed := routes(exit("A", "0.0.0.0/0", false), exit("B", "0.0.0.0/0", true), subnet)
+	for i := 0; i < 20; i++ {
+		p := &DefaultManager{routeSelector: routeselector.NewRouteSelector(), pinnedExit: "A"}
+		p.updateRouteSelectorFromManagement(mixed)
+		var got []string
+		for id := range p.selected(mixed) {
+			got = append(got, string(id))
+		}
+		sort.Strings(got)
+		if !same(got, []string{"A|0.0.0.0/0", "B|10.1.0.0/24"}) {
+			t.Fatalf("pinned A with B's subnet: installed %v", got)
+		}
+	}
+	// One manager across maps: B first offers only a default route, then a subnet too; the subnet gets through.
+	later := &DefaultManager{routeSelector: routeselector.NewRouteSelector(), pinnedExit: "A"}
+	firstMap := routes(exit("A", "0.0.0.0/0", false), exit("B", "0.0.0.0/0", true))
+	later.updateRouteSelectorFromManagement(firstMap)
+	if got := installed(later, firstMap); !same(got, []string{"A"}) {
+		t.Fatalf("first map: installed %v", got)
+	}
+	secondMap := routes(exit("A", "0.0.0.0/0", false), exit("B", "0.0.0.0/0", true), subnet)
+	later.updateRouteSelectorFromManagement(secondMap)
+	var second []string
+	for id := range later.selected(secondMap) {
+		second = append(second, string(id))
+	}
+	sort.Strings(second)
+	if !same(second, []string{"A|0.0.0.0/0", "B|10.1.0.0/24"}) {
+		t.Fatalf("second map: installed %v", second)
+	}
+	// The pinned node's "-v6" ID without its IPv4 base on the map: its subnet stays, its default route never.
+	v6lan := &route.Route{ID: "A-v6-lan", NetID: "A-v6", Network: netip.MustParsePrefix("10.2.0.0/24"), Peer: "C"}
+	orphan := routes(exit("A-v6", "::/0", true), v6lan)
+	o := &DefaultManager{routeSelector: routeselector.NewRouteSelector(), pinnedExit: "A"}
+	o.updateRouteSelectorFromManagement(orphan)
+	var got []string
+	for id := range o.selected(orphan) {
+		got = append(got, string(id))
+	}
+	if !same(got, []string{"A-v6|10.2.0.0/24"}) {
+		t.Fatalf("A-v6 without A: installed %v", got)
+	}
+	// Not pinned: management's auto-apply as before.
+	free := &DefaultManager{routeSelector: routeselector.NewRouteSelector()}
+	free.updateRouteSelectorFromManagement(routes(exit("A", "0.0.0.0/0", false), exit("B", "0.0.0.0/0", true)))
+	if !free.routeSelector.IsSelected("B") || free.routeSelector.IsSelected("A") {
+		t.Fatal("without a pin, management's auto-applied exit node is used")
+	}
+}
